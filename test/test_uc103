# ═══════════════════════════════════════════════════════════════════════════
#                            UTILITY FUNCTIONS
# ═══════════════════════════════════════════════════════════════════════════

print_title() {
    echo ""
    echo -e "${BLUE}════════════════════════════════════════════════════════════════${NC}"
    echo -e "${BLUE}$1${NC}"
    echo -e "${BLUE}════════════════════════════════════════════════════════════════${NC}"
    echo ""
}

print_section() {
    echo ""
    echo -e "${YELLOW}────────────────────────────────────────────────────────────────${NC}"
    echo -e "${YELLOW}$1${NC}"
    echo -e "${YELLOW}────────────────────────────────────────────────────────────────${NC}"
    echo ""
}

test_endpoint() {
    local test_name=$1
    local method=$2
    local endpoint=$3
    local data=$4
    local expected_status=$5
    local require_auth=$6
    
    TEST_NUM=$((TEST_NUM + 1))
    
    if [ $TEST_NUM -eq 1 ]; then
        if ! curl -s "$BASE_URL/community/posts" -o /dev/null 2>&1; then
            echo -e "${RED}✗ ERROR: Cannot connect to $BASE_URL${NC}"
            echo "   Please start the backend server: mvn spring-boot:run"
            exit 1
        fi
    fi
    
    printf "Test %2d: %-50s " "$TEST_NUM" "$test_name"
    
    local headers="-H 'Content-Type: application/json'"
    [ "$require_auth" = "true" ] && headers="$headers -H 'Authorization: $BEARER_TOKEN'"
    
    local response
    if [ -z "$data" ]; then
        response=$(eval "curl -s -w '\\n%{http_code}' -X $method $headers '$BASE_URL$endpoint'")
    else
        response=$(eval "curl -s -w '\\n%{http_code}' -X $method $headers -d '$data' '$BASE_URL$endpoint'")
    fi
    
    local status=$(echo "$response" | tail -n1)
    local body=$(echo "$response" | head -n-1)
    
    if [ "$status" = "$expected_status" ]; then
        echo -e "${GREEN}✓ PASS${NC} (HTTP $status)"
        PASS_COUNT=$((PASS_COUNT + 1))
        return 0
    else
        echo -e "${RED}✗ FAIL${NC} (Expected HTTP $expected_status, got $status)"
        echo "   Response: $(echo "$body" | head -c 80)..."
        FAIL_COUNT=$((FAIL_COUNT + 1))
        return 1
    fi
}

print_summary() {
    local total=$((PASS_COUNT + FAIL_COUNT))
    
    echo ""
    print_title "TEST SUMMARY"
    
    echo "Total Tests:  $total"
    echo -e "Passed:       ${GREEN}$PASS_COUNT${NC}"
    echo -e "Failed:       ${RED}$FAIL_COUNT${NC}"
    echo ""
    
    if [ $FAIL_COUNT -eq 0 ]; then
        echo -e "${GREEN}✓ ALL TESTS PASSED!${NC}"
        echo "UC103 Community Support API is working correctly."
        return 0
    else
        echo -e "${RED}✗ SOME TESTS FAILED${NC}"
        echo "Please review the failed tests above."
        return 1
    fi
}

